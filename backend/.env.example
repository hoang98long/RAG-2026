DATABASE_URL=sqlite:///./rag.db
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b
# Có thể thử qwen3-embedding:4b nếu đủ RAM/VRAM; phải reindex sau khi đổi.
EMBEDDING_MODEL=qwen3-embedding:0.6b
CHROMA_DIR=./chroma_data
UPLOAD_DIR=./storage/uploads
# Kích thước tính bằng ký tự Unicode, không phải token.
CHUNK_SIZE=1600
CHUNK_OVERLAP=240
TOP_K=6
RETRIEVAL_CANDIDATES=48
# Ngưỡng cosine cho nhánh vector; nhánh BM25 vẫn giữ kết quả từ khóa.
MIN_SIMILARITY=0.0
MAX_CONTEXT_CHARS=14000
LLM_NUM_CTX=16384
LLM_NUM_PREDICT=2048
EMBEDDING_BATCH_SIZE=32
EMBEDDING_QUERY_INSTRUCTION=Given a question, retrieve relevant document passages that answer the question.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Two-stage reranking: ollama reuses LLM_MODEL when RERANK_MODEL is empty.
RERANK_BACKEND=ollama
RERANK_MODEL=
RERANK_CANDIDATES=32
RERANK_BATCH_SIZE=6
RERANK_MIN_GRADE=2
RERANK_TIMEOUT=120
# Optional multilingual cross encoder: pip install -r requirements-reranker.txt
CROSS_ENCODER_MODEL=BAAI/bge-reranker-v2-m3
CROSS_ENCODER_DEVICE=cpu
CROSS_ENCODER_MAX_LENGTH=1024
# Set CROSS_ENCODER_MIN_SCORE only after calibration on labeled queries.
CITATION_REPAIR=true

# Larger uploads and bounded index scans (MiB = 1024 * 1024 bytes).
UPLOAD_MAX_FILE_MB=200
UPLOAD_MAX_REQUEST_MB=512
UPLOAD_MAX_FILES=20
INDEX_PAGE_SIZE=500

# Public corpus: physically separate from the existing private data.
PUBLIC_DATABASE_URL=sqlite:///./storage/public/public.db
PUBLIC_CHROMA_DIR=./public_chroma_data
PUBLIC_UPLOAD_DIR=./storage/public/uploads
# Backend only. Leave blank until you choose to enable OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT=90
# Multi-query + neighboring/appendix evidence; two display links per document.
QUERY_EXPANSION=true
GROUNDING_VERIFICATION=true
EVIDENCE_MAX_CHUNKS=80
EXHAUSTIVE_CONTEXT_CHARS=32000
EXHAUSTIVE_NUM_PREDICT=4096
NEIGHBOR_CHUNKS=1

# Bounded network requests and exact quote verification batches.
LLM_TIMEOUT=180
EMBEDDING_TIMEOUT=120
REVIEW_BATCH_SIZE=6
